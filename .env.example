# Copy to .env.local (git-ignored) and adjust. Restart `npm run dev` after changes.

# Where the app loads session data from:
#   local - static JSON files in public/data, built by pipeline/export.py (default)
#   api   - the live OpenF1 API (https://api.openf1.org/v1)
# Unset or empty means "local"; any other value logs a console warning and uses "local".
# Vite bakes this in at build time: on Vercel, set it as a project environment
# variable and redeploy to change it.
VITE_DATA_SOURCE=local
